{
  "name": "05.Craft Mountain – Unused Perk Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "01cc0831-49bc-4693-b808-d77893eaddf5",
      "name": "Daily 10:00 (Denver)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        16,
        -16
      ]
    },
    {
      "parameters": {},
      "id": "01d29176-fb81-4d3e-90e9-cfa1dc0fa785",
      "name": "Run Manually (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        16,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// CONFIG – unused-perk reminders (see README.md)\n// ============================================================\nreturn [{ json: {\n  LOCATION_ID: 'XTpY4DQ6CrYVvesFdX3K',\n  REMIND_ON_DAYS: [20],         // days of the month to send a reminder\n  REMIND_DAYS_BEFORE_END: [3],  // last-chance reminder, e.g. 3 = Sep 27 in a 30-day month\n  REMINDER_TAG: 'perk-reminder', // GHL workflow on this tag sends the SMS / email\n  FIELD_IDS: {\n    mugNumber: 'vWklTcHjmQV1tW52XIAb',\n    unusedPerks: 'Iq0lDam7VOp7aMyTMxn6',\n    perksExpireOn: 't2zMwUi6cL6NzpzqipvS',\n  },\n  // Monthly perks, in the order they are listed in the message\n  PERKS: [\n    { label: 'Free Monthly Pour',                   status: 'nQ1XQVxK7dt5x2jkmzQK', period: 'sfwSQ746eytoaIErT1xL' },\n    { label: '50% off a 4-Pack',                    status: 'CPdRbUyVL44UpTcIOHzc', period: 'BpyqJNV3NHbz4mdskVzq' },\n    { label: '10% off merchandise',                 status: 'hUof3kNaxMaSle2hym89', period: 'KKeZG0ZINPUecpSVpyhG' },\n    { label: '24oz beer at the 16oz price',         status: 'wrl8FbQuiPNbEATFZcUY', period: '72x0lCUx388Wko8MGSlC' },\n  ],\n}}];"
      },
      "id": "556dcab8-cddc-464f-a6f5-a34fd24287ea",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Scheduled runs continue only on a reminder day; manual test runs always continue.\nconst cfg = $('Config').first().json;\nconst today = $now;\nconst daysLeft = today.endOf('month').day - today.day;\nconst due = cfg.REMIND_ON_DAYS.includes(today.day) || cfg.REMIND_DAYS_BEFORE_END.includes(daysLeft);\nif (!due && $execution.mode !== 'manual') return [];\nconst items = [];\nfor (let page = 1; page <= 10; page++) items.push({ json: { page, pageLimit: 100 } }); // up to 1,000 members\nreturn items;"
      },
      "id": "645683f6-5367-4205-a5cc-485a931e6c0e",
      "name": "Is Reminder Day?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ locationId: $('Config').first().json.LOCATION_ID, page: $json.page, pageLimit: $json.pageLimit, filters: [ { field: 'customFields.' + $('Config').first().json.FIELD_IDS.mugNumber, operator: 'exists' } ] }) }}",
        "options": {}
      },
      "id": "ac382c98-66ec-46e8-a8a3-0d0b1941b702",
      "name": "Find Members with Mug #",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        736,
        96
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "02x3PFajRyULMOOr",
          "name": "Douq GHL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One item per member with at least one monthly perk not used this month.\nconst cfg = $('Config').first().json;\nconst period = $now.toFormat('yyyy-MM');\nconst expires = $now.endOf('month').toFormat('LLL d');\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  for (const c of item.json.contacts || []) {\n    if (seen.has(c.id)) continue;\n    seen.add(c.id);\n    const cf = {};\n    for (const f of c.customFields || []) cf[f.id] = f.value;\n    const used = (p) => cf[p.status] === 'Redeemed' && cf[p.period] === period;\n    const unused = cfg.PERKS.filter(p => !used(p)).map(p => p.label);\n    if (!unused.length) continue;\n    const list = unused.length === 1 ? unused[0] : `${unused.slice(0, -1).join(', ')} and ${unused.at(-1)}`;\n    out.push({ json: { contactId: c.id, unusedPerks: list, perksExpireOn: expires } });\n  }\n}\nreturn out;"
      },
      "id": "0da96284-f696-4057-b2e0-a067075559ee",
      "name": "Pick Members to Remind",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        96
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.contactId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customFields: [ { id: $('Config').first().json.FIELD_IDS.unusedPerks, field_value: $json.unusedPerks }, { id: $('Config').first().json.FIELD_IDS.perksExpireOn, field_value: $json.perksExpireOn } ] }) }}",
        "options": {}
      },
      "id": "87993f0a-a691-4a11-ad3d-ffe15297351c",
