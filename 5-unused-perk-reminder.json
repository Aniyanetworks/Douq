      "id": "bdbc3b87-0637-4a94-8066-c113fd9084d1",
      "name": "Tag perk-reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1696,
        96
      ],
      "credentials": {
        "httpBearerAuth": {
