    {
      "parameters": {
        "jsCode": "// One \"Reminder Log\" record per member reminded.\nconst cfg = $('Config').first().json;\nconst reminded = $('Pick Members to Remind').all();\nconst daysLeft = $now.endOf('month').day - $now.day;\nconst kind = $execution.mode === 'manual' ? 'Test reminder'\n  : cfg.REMIND_DAYS_BEFORE_END.includes(daysLeft) ? 'Last-chance reminder' : 'Reminder';\nreturn $input.all().map((_, i) => {\n  const m = reminded.at(i).json;\n  return { json: {\n    contactId: m.contactId,\n    properties: {\n      mark_as_unique: `#${m.mug || '–'} · ${kind}`, // primary field (shown as Title in GHL)\n      sent_at: new Date().toISOString(),\n      business_day: $now.toFormat('yyyy-MM-dd'),\n      mug: m.mug,\n      member: m.name,\n      kind,\n      unused_perks: m.unusedPerks,\n      expires_on: m.perksExpireOn,\n    },\n  } };\n});"
      },
