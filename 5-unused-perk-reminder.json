    {
      "parameters": {
        "jsCode": "const rows = $('Build Reminder Log').all();\nreturn $input.all()\n  .map((item, i) => ({ json: { recordId: (item.json.record || item.json).id, contactId: rows.at(i).json.contactId } }))\n  .filter(i => i.json.recordId && i.json.contactId);"
      },
