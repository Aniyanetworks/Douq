      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// Prints each GHL custom field with its ID – copy the IDs into the Config nodes.\nconst fields = $json.customFields || [];\nreturn fields.map(f => ({ json: { name: f.name, id: f.id, key: f.fieldKey, type: f.dataType } }));"
      }
    },
