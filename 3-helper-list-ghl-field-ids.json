      "name": "List Pipeline Stage IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        520
      ],
      "parameters": {
        "jsCode": "// Prints every pipeline stage with its ID - copy them into the Config nodes.\nconst out = [];\nfor (const p of $json.pipelines || []) for (const s of p.stages || []) out.push({ json: { pipeline: p.name, pipelineId: p.id, stage: s.name, stageId: s.id } });\nreturn out;"
      }
    }
