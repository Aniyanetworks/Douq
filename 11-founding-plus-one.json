    {
      "parameters": {
        "jsCode": "// Reads the partner details the member typed on the Founding Membership + One form.\nconst cfg = $('Config').first().json;\nconst member = $('Get Member').first().json.contact || {};\nconst cf = {};\nfor (const f of member.customFields || []) cf[f.id] = f.value;\nconst F = cfg.FIELD_IDS;\nconst val = (id) => String(cf[id] || '').trim();\nconst partnerEmail = val(F.partnerEmail).toLowerCase();\nconst memberEmail = String(member.email || '').trim().toLowerCase();\nif (!partnerEmail || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(partnerEmail)) return [{ json: { skip: 'No valid partner email' } }];\nif (partnerEmail === memberEmail) return [{ json: { skip: \"Partner email is the member's own email\" } }];\nreturn [{ json: {\n  skip: '',\n  memberId: member.id,\n  partnerEmail,\n  partnerFirstName: val(F.partnerFirstName),\n  partnerLastName: val(F.partnerLastName),\n  partnerPhone: val(F.partnerPhone),\n  memberFirstName: member.firstName || '',\n  memberLastName: member.lastName || '',\n  memberEmail,\n  memberPhone: member.phone || '',\n} }];"
      },
      "id": "f7bac061-ffb4-40bc-805c-b6b674d3a2ba",
      "name": "Read Partner Details",
