    {
      "parameters": {
        "jsCode": "// Builds the partner as a Founding Member of their own: own contact, founder tag (so workflow 4 gives an F number), own perks.\n// Their Partner fields point back at the member. A partner who is already a member is left alone.\nconst cfg = $('Config').first().json;\nconst d = $('Read Partner Details').first().json;\nconst existing = $json.contact || null;\nif (existing && (existing.tags || []).includes(cfg.MEMBER_TAG)) {\n  return [{ json: { created: false, reason: 'Partner is already a member', partnerId: existing.id } }];\n}\nconst F = cfg.FIELD_IDS;\nconst cf = (id, v) => (v ? [{ id, field_value: v }] : []);\nconst body = {\n  locationId: cfg.LOCATION_ID,\n  email: d.partnerEmail,\n  firstName: d.partnerFirstName || undefined,\n  lastName: d.partnerLastName || undefined,\n  phone: d.partnerPhone || undefined,\n  source: 'Founding Membership + One',\n  tags: [...new Set([...((existing && existing.tags) || []), cfg.FOUNDER_TAG, cfg.PARTNER_TAG])], // keeps the tags the contact already has (upsert would replace them)\n  customFields: [\n    ...cf(F.partnerFirstName, d.memberFirstName),\n    ...cf(F.partnerLastName, d.memberLastName),\n    ...cf(F.partnerEmail, d.memberEmail),\n    ...cf(F.partnerPhone, d.memberPhone),\n  ],\n};\nreturn [{ json: { created: true, body } }];"
      },
