        "jsCode": "// ============================================================\n// CONFIG - Founding Membership + One (see README.md)\n// ============================================================\nreturn [{ json: {\n  LOCATION_ID: 'XTpY4DQ6CrYVvesFdX3K',\n  MEMBER_TAG: 'mug-club-member', // a partner who already has this tag is left alone\n  FOUNDER_TAG: 'founder',        // both people get it, so they get F numbers and count toward the 50\n  PARTNER_TAG: 'founding-partner', // marks the person who joined as the \"+ One\"\n  NEW_MEMBER_URL: 'https://n8n.srv1300653.hstgr.cloud/webhook/new-member', // workflow 4: mug number, perks, member tag\n  FIELD_IDS: { // the Partner fields of the Plus One form (same fields as workflow 8)\n    partnerFirstName: 'hI3sepNhpwOxGwyQOhRZ',\n    partnerLastName: 'SNkcXyVNmEgFHUOygCMY',\n    partnerEmail: '3EchTsgaL50DSvuQDoCC',\n    partnerPhone: 'es7Of9Be8D6u2QhzqhMd',\n  },\n}}];"
      },
