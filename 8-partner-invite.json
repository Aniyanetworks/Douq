    {
      "parameters": {
        "jsCode": "// ============================================================\n// CONFIG - partner invite (see README.md)\n// ============================================================\nreturn [{ json: {\n  LOCATION_ID: 'XTpY4DQ6CrYVvesFdX3K',\n  MEMBER_TAG: 'mug-club-member', // a partner who already has this tag is left alone\n  INVITED_TAG: 'partner-invited', // GHL workflow on this tag sends the partner invite\n  FIELD_IDS: {\n    partnerFirstName: 'hI3sepNhpwOxGwyQOhRZ',\n    partnerLastName: 'SNkcXyVNmEgFHUOygCMY',\n    partnerEmail: '3EchTsgaL50DSvuQDoCC',\n    partnerPhone: 'es7Of9Be8D6u2QhzqhMd',\n    partnerStatus: 'J5PpUqzNekLivH5FeGGU',\n  },\n}}];"
      },
      "id": "d8121f2d-7b2c-4b58-9a86-3a302790b667",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Partner Invite Webhook').first().json.body.contact_id || $('Partner Invite Webhook').first().json.body.contactId || $('Partner Invite Webhook').first().json.body.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "7f1101ab-1fb5-4e28-a213-a35c4929e64f",
      "name": "Get Member",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        300
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "02x3PFajRyULMOOr",
          "name": "Douq GHL"
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Reads the partner details the member typed on the signup form.\nconst cfg = $('Config').first().json;\nconst member = $('Get Member').first().json.contact || {};\nconst cf = {};\nfor (const f of member.customFields || []) cf[f.id] = f.value;\nconst F = cfg.FIELD_IDS;\nconst val = (id) => String(cf[id] || '').trim();\nconst partnerEmail = val(F.partnerEmail).toLowerCase();\nconst memberEmail = String(member.email || '').trim().toLowerCase();\nif (!partnerEmail || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(partnerEmail)) return [{ json: { skip: 'No valid partner email' } }];\nif (partnerEmail === memberEmail) return [{ json: { skip: \"Partner email is the member's own email\" } }];\nreturn [{ json: {\n  skip: '',\n  memberId: member.id,\n  partnerEmail,\n  partnerFirstName: val(F.partnerFirstName),\n  partnerLastName: val(F.partnerLastName),\n  partnerPhone: val(F.partnerPhone),\n  memberFirstName: member.firstName || '',\n  memberLastName: member.lastName || '',\n  memberEmail,\n  memberPhone: member.phone || '',\n} }];"
      },
      "id": "91ab15f1-6373-4b7a-b48e-f76d30b3c0ee",
      "name": "Read Partner Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "93155865-0ae8-4c20-9f01-0478ae1852d5",
              "leftValue": "={{ $json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
