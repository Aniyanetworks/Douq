        "url": "=https://services.leadconnectorhq.com/contacts/search/duplicate?locationId={{ $('Config').first().json.LOCATION_ID }}&email={{ encodeURIComponent($json.partnerEmail) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
