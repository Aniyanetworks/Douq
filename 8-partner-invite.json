      "id": "ad455136-683a-4eed-88b9-543845ad62a0",
      "name": "Find Partner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "02x3PFajRyULMOOr",
          "name": "Douq GHL"
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Builds the partner contact. The partner's own \"Partner\" fields point back at the member,\n// so the invite email can say \"join Essential Members with <member>\".\nconst cfg = $('Config').first().json;\nconst d = $('Read Partner Details').first().json;\nconst existing = $json.contact || null;\nif (existing && (existing.tags || []).includes(cfg.MEMBER_TAG)) {\n  return [{ json: { created: false, reason: 'Partner is already a member', partnerId: existing.id } }];\n}\nconst F = cfg.FIELD_IDS;\nconst cf = (id, v) => (v ? [{ id, field_value: v }] : []);\nconst body = {\n  locationId: cfg.LOCATION_ID,\n  email: d.partnerEmail,\n  firstName: d.partnerFirstName || undefined,\n  lastName: d.partnerLastName || undefined,\n  phone: d.partnerPhone || undefined,\n  source: 'Partner invite',\n  tags: [cfg.INVITED_TAG],\n  customFields: [\n    ...cf(F.partnerFirstName, d.memberFirstName),\n    ...cf(F.partnerLastName, d.memberLastName),\n    ...cf(F.partnerEmail, d.memberEmail),\n    ...cf(F.partnerPhone, d.memberPhone),\n    ...cf(F.partnerStatus, 'Invited'),\n  ],\n};\nreturn [{ json: { created: true, body } }];"
      },
