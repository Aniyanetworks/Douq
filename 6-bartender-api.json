    {
      "parameters": {
        "jsCode": "// Member list for the site: mug, name, and this month's perk status.\nconst cfg = $('Config').first().json;\nconst period = $now.toFormat('yyyy-MM');\nconst day = (v) => (v ? String(v).slice(0, 10) : '');\nconst seen = new Set();\nconst members = [];\nfor (const item of $input.all()) {\n  for (const c of item.json.contacts || []) {\n    if (seen.has(c.id) || !(c.tags || []).includes(cfg.MEMBER_TAG)) continue; // guests are not listed\n    seen.add(c.id);\n    const cf = {};\n    for (const f of c.customFields || []) cf[f.id] = f.value;\n    const mug = String(cf[cfg.MUG_FIELD] || '').trim();\n    if (!mug) continue;\n    members.push({\n      id: c.id,\n      mug,\n      name: [c.firstName, c.lastName].filter(Boolean).join(' ') || c.email || 'Unknown',\n      phone: c.phone || '',\n      email: c.email || '',\n      perks: cfg.PERKS.map(p => {\n        const used = cf[p.status] === 'Redeemed' && cf[p.period] === period;\n        return { key: p.key, label: p.label, used, date: used ? day(cf[p.date]) : '' };\n      }),\n      initialPour: day(cf[cfg.INITIAL_POUR_DATE]),\n      mugStatus: cf[cfg.MUG_STATUS_FIELD] || '',\n    });\n  }\n}\nmembers.sort((a, b) => a.mug.localeCompare(b.mug, undefined, { numeric: true }));\nconst result = { period, updatedAt: new Date().toISOString(), members };\n$getWorkflowStaticData('global').members = { at: Date.now(), result };\nreturn [{ json: result }];"
      },
