    {
      "parameters": {
        "jsCode": "// Checks the staff PIN and picks what the site asked for: members | log.\nconst cfg = $('Config').first().json;\nconst body = $('Bar API Webhook').first().json.body || {};\nif (!cfg.STAFF_PIN || cfg.STAFF_PIN === 'CHANGE-ME' || String(body.pin || '') !== String(cfg.STAFF_PIN)) {\n  return [{ json: { route: 'denied' } }];\n}\nreturn [{ json: { route: ['log', 'reminders'].includes(body.action) ? body.action : 'members', from: body.from || '', to: body.to || '' } }];"
      },
