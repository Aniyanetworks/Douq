    {
      "parameters": {
        "jsCode": "// Perk Log records between from and to (business days, YYYY-MM-DD), newest first.\nconst req = $('Check Request').first().json;\nconst from = req.from || '0000-00-00';\nconst to = req.to || '9999-99-99';\nconst prop = (p, k) => p[k] ?? p[`custom_objects.perk_logs.${k}`] ?? '';\nconst seen = new Set();\nconst log = [];\nfor (const item of $input.all()) {\n  for (const r of item.json.records || []) {\n    if (seen.has(r.id)) continue;\n    seen.add(r.id);\n    const p = r.properties || {};\n    const loggedAt = prop(p, 'logged_at') || r.createdAt || '';\n    const businessDay = String(prop(p, 'business_day') || loggedAt).slice(0, 10);\n    if (businessDay < from || businessDay > to) continue;\n    log.push({\n      loggedAt, businessDay,\n      mug: prop(p, 'mug'), member: prop(p, 'member'), perk: prop(p, 'perk'), event: prop(p, 'event'),\n      orderId: prop(p, 'toast_order_id'), checkNumber: prop(p, 'check_number'), detail: prop(p, 'detail'),\n    });\n  }\n}\nlog.sort((a, b) => String(b.loggedAt).localeCompare(String(a.loggedAt)));\nreturn [{ json: { from: req.from, to: req.to, log } }];"
      },
