    {
      "parameters": {
        "jsCode": "// Staff set a member's mug status (Requested / Ordered / Received / Delivered / Cancelled) from the bar site.\nconst cfg = $('Config').first().json;\nconst req = $('Check Request').first().json;\nif (!/^[A-Za-z0-9]{10,40}$/.test(req.contactId)) throw new Error('Bad contact id');\nif (!cfg.MUG_STATUSES.includes(req.status)) throw new Error('Bad mug status');\nif (!cfg.MUG_STATUS_FIELD || cfg.MUG_STATUS_FIELD.startsWith('REPLACE')) throw new Error('MUG_STATUS_FIELD is not set in Config');\n$getWorkflowStaticData('global').members = null; // the next member list read sees the change\nreturn [{ json: { contactId: req.contactId, status: req.status, tag: cfg.MUG_STATUS_TAGS[req.status] } }];"
      },
