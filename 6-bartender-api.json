      "parameters": {
        "jsCode": "// ============================================================\n// CONFIG – bartender site API (see bar-app/README.md)\n// ============================================================\nreturn [{ json: {\n  STAFF_PIN: 'CHANGE-ME',   // shared PIN bartenders type on the site – change it when staff leave\n  LOCATION_ID: 'XTpY4DQ6CrYVvesFdX3K',\n  MUG_FIELD: 'vWklTcHjmQV1tW52XIAb',\n  MUG_STATUS_FIELD: 'citZ7RA1sh8YIjMkfmhH', // GHL dropdown: Requested / Ordered / Received / Delivered / Cancelled\n  MUG_STATUSES: ['Requested', 'Ordered', 'Received', 'Delivered', 'Cancelled'],\n  MUG_STATUS_TAGS: { Requested: 'ordered by member', Ordered: 'order processing by vendor', Received: 'received by bartender', Delivered: 'delivered to member', Cancelled: 'mug order cancelled' }, // a GHL workflow on each tag texts the member\n  INITIAL_POUR_DATE: 'i9s94p3uVbJ8Gs5IrWHU',\n  REMINDER_LOG_OBJECT: 'custom_objects.reminder_logs',\n  MEMBER_TAG: 'mug-club-member',     // only Mug Club members are listed\n  MEMBER_CACHE_SECONDS: 60, // all tablets share one GHL read per minute\n  // Monthly perks shown on each member card\n  PERKS: [\n    { key: 'free_pour', label: 'Free Monthly Pour',   status: 'nQ1XQVxK7dt5x2jkmzQK', period: 'sfwSQ746eytoaIErT1xL', date: 'Kzbwb0nNxFhlcNZoMrvP' },\n    { key: 'four_pack', label: '50% off 4-Pack',  status: 'CPdRbUyVL44UpTcIOHzc', period: 'BpyqJNV3NHbz4mdskVzq', date: 'HmCaCCkzQGO0AE69ca22' },\n    { key: 'merch',     label: 'Merchandise 10%',   status: 'hUof3kNaxMaSle2hym89', period: 'KKeZG0ZINPUecpSVpyhG', date: '4N9eBmteLZT32n7H26Di' },\n    { key: 'mug',       label: 'Special Mug Pricing (24oz beer at the 16oz price)', status: 'wrl8FbQuiPNbEATFZcUY', period: '72x0lCUx388Wko8MGSlC', date: 'NSE4Zsviw6HOoQkQB6t1' },\n  ],\n}}];"
      },
      "id": "6505dbac-7c6f-4631-be57-f33cd76be673",
