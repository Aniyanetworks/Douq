    {
      "parameters": {
        "jsCode": "// Reminder Log records between from and to (YYYY-MM-DD), newest first.\nconst req = $('Check Request').first().json;\nconst from = req.from || '0000-00-00';\nconst to = req.to || '9999-99-99';\nconst prop = (p, k) => p[k] ?? p[`custom_objects.reminder_logs.${k}`] ?? '';\nconst seen = new Set();\nconst reminders = [];\nfor (const item of $input.all()) {\n  for (const r of item.json.records || []) {\n    if (seen.has(r.id)) continue;\n    seen.add(r.id);\n    const p = r.properties || {};\n    const sentAt = prop(p, 'sent_at') || r.createdAt || '';\n    const day = String(prop(p, 'business_day') || sentAt).slice(0, 10);\n    if (day < from || day > to) continue;\n    reminders.push({\n      sentAt, day, mug: prop(p, 'mug'), member: prop(p, 'member'), kind: prop(p, 'kind'),\n      unusedPerks: prop(p, 'unused_perks'), expiresOn: prop(p, 'expires_on'),\n    });\n  }\n}\nreminders.sort((a, b) => String(b.sentAt).localeCompare(String(a.sentAt)));\nreturn [{ json: { from: req.from, to: req.to, reminders } }];"
      },
