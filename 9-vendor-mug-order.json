    {
      "parameters": {
        "jsCode": "// The page the vendor sees after clicking the email link. A button confirms (email scanners that only open the link change nothing).\nconst cfg = $('CFG Confirm').first().json;\nconst q = $('Processing Link Webhook').first().json.query || {};\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm order</title></head>`\n  + `<body style=\"font-family:Arial,sans-serif;max-width:420px;margin:60px auto;padding:0 16px;text-align:center\">`\n  + `<h2>Start processing this mug order?</h2><p>This tells Craft Mountain the order is in progress.</p>`\n  + `<form method=\"POST\" action=\"${cfg.BASE_URL}/mug-processing-confirm\">`\n  + `<input type=\"hidden\" name=\"c\" value=\"${esc(q.c || '')}\"><input type=\"hidden\" name=\"t\" value=\"${esc(q.t || '')}\">`\n  + `<button type=\"submit\" style=\"padding:12px 22px;font-size:16px;background:#b5651d;color:#fff;border:0;border-radius:6px;cursor:pointer\">Yes, start processing</button></form></body></html>`;\nreturn [{ json: { html } }];"
      },
      "id": "8a1352c5-120a-4a5d-a54a-c539273bc0b9",
      "name": "Confirm Page",
