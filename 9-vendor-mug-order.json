    {
      "parameters": {
        "jsCode": "// Only a member who has not been processed or cancelled yet moves to \"processing\".\nconst cfg = $('CFG Confirm 2').first().json;\nconst member = $json.contact || {};\nconst cf = {};\nfor (const f of member.customFields || []) cf[f.id] = f.value;\nconst status = String(cf[cfg.MUG_STATUS_FIELD] || '');\nif (!member.id) return [{ json: { proceed: false, page: 'invalid' } }];\nif (['Ordered', 'Received', 'Delivered'].includes(status)) return [{ json: { proceed: false, page: 'already' } }];\nif (status === 'Cancelled') return [{ json: { proceed: false, page: 'cancelled' } }];\nconst mug = String(cf[cfg.MUG_FIELD] || '').trim();\nreturn [{ json: { proceed: true, contactId: member.id, mug } }];"
      },
