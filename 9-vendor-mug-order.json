    {
      "parameters": {
        "jsCode": "// Reads the member's mug number; nothing is created when the order was already processed or cancelled.\nconst cfg = $('CFG').first().json;\nconst member = $('Get Member').first().json.contact || {};\nconst cf = {};\nfor (const f of member.customFields || []) cf[f.id] = f.value;\nconst mug = String(cf[cfg.MUG_FIELD] || '').trim();\nconst name = [member.firstName, member.lastName].filter(Boolean).join(' ') || member.email || member.id;\nconst set = (v) => v && !String(v).startsWith('REPLACE') && !String(v).startsWith('CHANGE-ME');\nif (!set(cfg.SECRET)) return [{ json: { skip: 'SECRET is not set in Config' } }];\nif (!set(cfg.LINK_FIELD)) return [{ json: { skip: 'LINK_FIELD is not set in Config' } }];\nif (!member.id) return [{ json: { skip: 'Member not found' } }];\nif (!mug) return [{ json: { skip: 'Member has no mug number yet' } }];\n// Follow-ups (reminders) and the first email stop once the vendor has confirmed, or the order was cancelled\nconst status = String(cf[cfg.MUG_STATUS_FIELD] || '');\nif (['Ordered', 'Received', 'Delivered', 'Cancelled'].includes(status)) return [{ json: { skip: `Mug status is already ${status}` } }];\nreturn [{ json: { skip: '', contactId: member.id, mug, name } }];"
      },
