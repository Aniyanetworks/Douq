    {
      "parameters": {
        "jsCode": "// The vendor pressed the confirm button: read and check the link values.\nconst body = $('Confirm Webhook').first().json.body || {};\nconst contactId = String(body.c || '');\nconst given = String(body.t || '');\nconst valid = /^[A-Za-z0-9]{10,40}$/.test(contactId) && /^[a-f0-9]{64}$/.test(given);\nreturn [{ json: { valid, contactId, given } }];"
      },
      "id": "f012b1a4-20c5-4900-8c90-0dbe6f82480f",
