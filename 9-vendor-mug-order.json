    {
      "parameters": {
        "jsCode": "// ============================================================\n// CONFIG - vendor mug orders (see README.md). Edit the SECRET, LINK_FIELD and BASE_URL in this node and in 'CFG Confirm 2' (same values).\n// ============================================================\nreturn [{ json: {\n  LOCATION_ID: 'XTpY4DQ6CrYVvesFdX3K',\n  BASE_URL: 'https://n8n.srv1300653.hstgr.cloud/webhook', // production webhook base of this n8n\n  SECRET: 'CHANGE-ME-LONG-RANDOM-TEXT', // signs the vendor's link; use 30+ random characters, never share it\n  MUG_FIELD: 'vWklTcHjmQV1tW52XIAb',\n  MUG_STATUS_FIELD: 'citZ7RA1sh8YIjMkfmhH',\n  PROCESSING_STATUS: 'Ordered',       // saved value shown as \"Order Processing by Vendor\"\n  PROCESSING_TAG: 'order processing by vendor',      // GHL workflow on this tag tells the member the mug is being made\n  // Custom field on the MEMBER contact that holds the vendor's confirm link; the GHL workflow puts it in the email to the vendor.\n  LINK_FIELD: 'REPLACE_WITH_VENDOR_ORDER_LINK_FIELD_ID',\n}}];"
      },
      "id": "f0ba571e-215b-4852-b13a-ca6370936126",
      "name": "CFG Confirm 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
