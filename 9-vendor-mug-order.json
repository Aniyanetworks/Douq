    {
      "parameters": {
        "jsCode": "// The signature must match the one we created when the order email was sent.\nconst given = $('Read Link').first().json.given;\nconst expected = String($json.token || '');\nlet diff = given.length === expected.length ? 0 : 1;\nfor (let i = 0; i < Math.min(given.length, expected.length); i++) diff |= given.charCodeAt(i) ^ expected.charCodeAt(i);\nreturn [{ json: { ok: diff === 0 && expected.length === 64, contactId: $('Read Link').first().json.contactId } }];"
      },
      "id": "f3cb446d-c986-4c0e-9105-0f5add3ccf7e",
