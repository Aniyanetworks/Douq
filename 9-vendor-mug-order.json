        "jsCode": "// The vendor's confirm link goes into a custom field on the MEMBER contact; the GHL workflow puts it in the email.\nconst cfg = $('CFG').first().json;\nconst d = $json;\nconst url = `${cfg.BASE_URL}/mug-processing?c=${encodeURIComponent(d.contactId)}&t=${encodeURIComponent(d.token)}`;\nreturn [{ json: { contactId: d.contactId, fields: [{ id: cfg.LINK_FIELD, field_value: url }] } }];"
