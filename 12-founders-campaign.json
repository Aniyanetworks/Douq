        "jsCode": "// The typed email and phone: an existing contact is only found and texted; a new one is created as \"Test Recipient\".\nconst cfg = $('Config').first().json;\nconst c = $('Check').first().json;\nconst found = $json.contact || null;\nconst body = { locationId: cfg.LOCATION_ID, email: c.email, phone: c.phone };\nif (!found) { body.firstName = 'Test'; body.lastName = 'Recipient'; body.source = 'Campaign test'; }\nreturn [{ json: { body } }];"
