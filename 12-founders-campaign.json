    {
      "parameters": {
        "jsCode": "// All contacts of the batch are tagged: the GHL workflow now sends the texts.\nconst c = $('Check').first().json;\nconst state = $getWorkflowStaticData('global');\nif (state.campaign && state.campaign.batches[c.batch]) state.campaign.batches[c.batch].finishedAt = new Date().toISOString();\nreturn [{ json: { ok: true, batch: c.batch } }];"
      },
      "id": "7c1fc9c7-44b5-417e-83e4-f98a2e8d552a",
      "name": "Finish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// New batch: contacts that could be texted (phone, SMS DND not set, not an earlier-campaign enrollee) and are not in a batch yet.\nconst cfg = $('Config').first().json;\nconst c = $('Check').first().json;\nconst seen = new Map();\nfor (const it of $input.all()) for (const x of (it.json.contacts || [])) seen.set(x.id, x);\nconst tags = (x) => (x.tags || []).map((t) => String(t).toLowerCase().trim());\nconst free = [...seen.values()].filter((x) => {\n  if (!String(x.phone || '').trim()) return false;\n  if (x.dnd === true) return false;\n  const sms = x.dndSettings && x.dndSettings.SMS;\n  if (sms && sms.status && sms.status !== 'inactive') return false;\n  const t = tags(x);\n  if (cfg.ENROLLEE_TAGS.some((e) => t.includes(e.toLowerCase()))) return false;\n  if (t.some((g) => g.startsWith(cfg.BATCH_TAG))) return false;\n  return true;\n});\nfree.sort((a, b) => (String(a.dateAdded || '') + a.id).localeCompare(String(b.dateAdded || '') + b.id));\nif (c.preview) return [{ json: { preview: true, available: free.length, max: cfg.MAX_BATCH_SIZE } }];\nconst state = $getWorkflowStaticData('global');\nstate.campaign = state.campaign || { batches: {} };\nconst batch = (state.campaign.maxBatch || cfg.BATCHES) + 1;\nconst list = free.slice(0, Math.min(c.size, cfg.MAX_BATCH_SIZE));\nif (!list.length) return [{ json: { preview: true, available: 0, max: cfg.MAX_BATCH_SIZE } }];\nstate.campaign.maxBatch = batch;\nreturn list.map((x) => ({ json: { id: x.id, tag: cfg.BATCH_TAG + batch, batch, count: list.length, preview: false } }));"
      },
