    {
      "parameters": {
        "jsCode": "// ============================================================\n// CONFIG - Founders text campaign in batches (see README.md)\n// ============================================================\nreturn [{ json: {\n  LOCATION_ID: 'XTpY4DQ6CrYVvesFdX3K',\n  SECRET: 'VTNLn3qmT0Sw2dcuICHPBtNdeBqA2BzQCKUaUpmN',            // the bar site API (workflow 6) calls this workflow with it; keep both the same\n  BATCHES: 6,                      // batches that exist from the start; \"New batch\" adds more (founders-batch-7 ...)\n  MAX_BATCH_SIZE: 490,             // a new batch stays under the 500 texts a day limit\n  BATCH_TAG: 'founders-batch-',\n  SEND_TAG: 'founders-send',       // the GHL workflow \"Founders Essential Text Blast\" starts when this tag is added\n  TEXT_TAGS: ['founders-text-1-sent', 'founders-text-2-sent', 'founders-text-3-sent'], // added by that workflow after each text\n  ENROLLEE_TAGS: ['2026-07-24 - founding member + one - enrollee', '2026-07-24 - founding member - enrollee'], // never texted by this campaign\n  TEST_CONTACTS: [{ id: 'qNo3fRDEi6v82RUJqEfq', label: 'Test User' }], // \"Send test\" texts only these contacts\n  TIMEZONE: 'America/Denver',      // \"today\" for the one-batch-a-day rule (SMS limit is 500 a day)\n}}];"
      },
      "id": "867daedc-3f4b-41e8-ae7a-4aa7e9e9c9a0",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Checks the secret and the request. A batch can be started once, and only one batch a day (the daily SMS limit).\nconst cfg = $('Config').first().json;\nconst body = $('Campaign Webhook').first().json.body || {};\nconst fail = (msg) => [{ json: { ok: false, error: msg } }];\nif (!cfg.SECRET || body.secret !== cfg.SECRET) return fail('Not allowed');\nconst state = $getWorkflowStaticData('global');\nstate.campaign = state.campaign || { batches: {} };\nconst maxBatch = state.campaign.maxBatch || cfg.BATCHES;\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: cfg.TIMEZONE });\nif (body.action === 'campaign-test') return [{ json: { ok: true, action: 'test', batch: 0 } }];\nif (body.action === 'campaign-newbatch') {\n  const preview = body.preview === true;\n  const size = parseInt(body.size, 10);\n  if (!preview && !(size >= 1 && size <= cfg.MAX_BATCH_SIZE)) return fail('Choose a size from 1 to ' + cfg.MAX_BATCH_SIZE);\n  return [{ json: { ok: true, action: 'newbatch', batch: 0, preview, size: preview ? 0 : size } }];\n}\nconst action = body.action === 'campaign-send' ? 'send' : 'status';\nif (action === 'send') {\n  const batch = parseInt(body.batch, 10);\n  if (!(batch >= 1 && batch <= maxBatch)) return fail('Unknown batch');\n  const b = state.campaign.batches;\n  if (b[batch]) return fail('Batch ' + batch + ' was already started');\n  const other = Object.keys(b).find((k) => b[k].startedDate === today);\n  if (other) return fail('Batch ' + other + ' was already started today. Send one batch a day to stay under the SMS limit.');\n  b[batch] = { startedAt: new Date().toISOString(), startedDate: today };\n  return [{ json: { ok: true, action, batch } }];\n}\nreturn [{ json: { ok: true, action, batch: 0 } }];"
      },
