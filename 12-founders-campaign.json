    {
      "parameters": {
        "jsCode": "// One search page per 100 contacts: the batch being started, all batches for the status view, or every contact for a new batch.\nconst cfg = $('Config').first().json;\nconst c = $('Check').first().json;\nconst state = $getWorkflowStaticData('global');\nconst maxBatch = (state.campaign && state.campaign.maxBatch) || cfg.BATCHES;\nconst items = [];\nif (c.action === 'newbatch') {\n  for (let page = 1; page <= 60; page++) items.push({ json: { batch: 0, page } });\n  return items;\n}\nconst batches = c.action === 'send' ? [c.batch] : Array.from({ length: maxBatch }, (_, i) => i + 1);\nfor (const batch of batches) for (let page = 1; page <= 6; page++) items.push({ json: { batch, page } });\nreturn items;"
      },
