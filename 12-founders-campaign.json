    {
      "parameters": {
        "jsCode": "// Sends: the contacts of the batch to tag. Status: counts per batch.\nconst cfg = $('Config').first().json;\nconst c = $('Check').first().json;\nconst pages = $('Pages').all();\nconst by = {};\n$input.all().forEach((it, i) => {\n  const b = pages[i] && pages[i].json.batch;\n  for (const x of (it.json.contacts || [])) { (by[b] = by[b] || new Map()).set(x.id, x); }\n});\nconst state = $getWorkflowStaticData('global');\nstate.campaign = state.campaign || { batches: {} };\nconst maxBatch = state.campaign.maxBatch || cfg.BATCHES;\nif (c.action === 'send') {\n  const list = [...(by[c.batch] || new Map()).values()];\n  state.campaign.batches[c.batch].queued = list.length;\n  return list.map((x) => ({ json: { id: x.id, status: false } }));\n}\nconst has = (x, t) => (x.tags || []).some((g) => String(g).toLowerCase() === t);\nconst batches = [];\nfor (let b = 1; b <= maxBatch; b++) {\n  const list = [...(by[b] || new Map()).values()];\n  const st = state.campaign.batches[b] || null;\n  batches.push({\n    batch: b,\n    total: list.length,\n    texts: cfg.TEXT_TAGS.map((t) => list.filter((x) => has(x, t)).length),\n    started: !!st,\n    startedAt: st ? st.startedAt : '',\n    startedDate: st ? st.startedDate : '',\n    queued: st && st.queued != null ? st.queued : 0,\n    finishedAt: st && st.finishedAt ? st.finishedAt : '',\n    sending: !!(st && !st.finishedAt),\n  });\n}\nreturn [{ json: { status: true, batches, today: new Date().toLocaleDateString('en-CA', { timeZone: cfg.TIMEZONE }), updatedAt: new Date().toISOString() } }];"
      },
